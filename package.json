{
  "name": "jev-hammer",
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time ad ranking and creative review on a typed evaluation model. One call prices a whole auction.",
  "scripts": {
    "shop": "node shop.js",
    "feed": "node feed.js",
    "eval": "node eval.js",
    "test": "node test.js",
    "ui": "node ui/server.mjs",
    "record": "node ui/record.mjs --pages 4 --pace 1.35",
    "vo": "node ui/vo.mjs"
  },
  "dependencies": {
    "jev-guard": "^0.3.1"
  },
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./auction": "./src/auction.js",
    "./rank": "./src/rank.js"
  },
  "files": [
    "index.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "jev",
    "typesafe",
    "ads",
    "ad-ranking",
    "recommendation",
